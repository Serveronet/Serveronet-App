{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "arokettu/bencode": "^4.3",
        "christian-riesen/base32": "^1.6",
        "doctrine/dbal": "^3.6",
        "guzzlehttp/guzzle": "^7.2",
        "imliam/laravel-env-set-command": "3.0.0",
        "jeremykendall/php-domain-parser": "^6.0",
        "laravel/breeze": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.5",
        "laravel/sail": "^1.0.1",
        "laravel/sanctum": "^4.0",
        "laravel/serializable-closure": "^2.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.4",
        "league/flysystem-ftp": "^3.0",
        "livewire/livewire": "^3.4",
        "megahertz/guzzle-tor": "^1.1",
        "mikepultz/netdns2": "^2.0",
        "mtownsend/xml-to-array": "^2.0",
        "nunomaduro/collision": "^8.1",
        "nunomaduro/termwind": "^2.0",
        "paragonie/pqcrypto_compat": "^0.3.2",
        "pear/net_dns2": "^1.5",
        "power-components/livewire-powergrid": "^6.7",
        "spatie/url": "^2.4",
        "stephenhill/base58": "^1.1",
        "symfony/filesystem": "^7.2"
    },
    "require-dev": {
        "knuckleswtf/scribe": "*",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/global-helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
